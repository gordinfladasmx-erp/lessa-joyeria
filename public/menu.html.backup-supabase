  document.getElementById('cfg-body').innerHTML = html

  // Footer con qty
  document.getElementById('cfg-footer').innerHTML =
    '<div class="qty-row-big">' +
      '<button class="qty-btn-big" onclick="cfgQty(-1)">−</button>' +
      '<span class="qty-num-big">'+configProd.qty+'</span>' +
      '<button class="qty-btn-big add" onclick="cfgQty(1)">+</button>' +
      '<span class="cfg-total">$'+Math.round(total)+'</span>' +
    '</div>' +
    '<button class="btn btn-red" onclick="confirmarConfig()" style="background:'+color+'">Agregar al pedido · $'+Math.round(total)+'</button>'
}

function togGuiso1(g){ if(configProd.guiso1.includes(g)) configProd.guiso1=configProd.guiso1.filter(function(x){return x!==g}); else configProd.guiso1=[g]; renderConfig() }
function togGuisoX(g){ if(configProd.guisoX.includes(g)) configProd.guisoX=configProd.guisoX.filter(function(x){return x!==g}); else configProd.guisoX.push(g); renderConfig() }
function togSalsa(n){ if(configProd.salsas.includes(n)) configProd.salsas=configProd.salsas.filter(function(x){return x!==n}); else configProd.salsas.push(n); renderConfig() }
function togTop(n){ if(configProd.tops.includes(n)) configProd.tops=configProd.tops.filter(function(x){return x!==n}); else configProd.tops.push(n); renderConfig() }
function setSabor(s){ configProd.sabor=s; renderConfig() }
function setLeche(l){ configProd.leche=l; renderConfig() }
function cfgQty(d){ configProd.qty=Math.max(1,configProd.qty+d); renderConfig() }

function confirmarConfig() {
  var p = configProd.p
  var precioExtra = p.precio_extra>0?p.precio_extra:PRECIO_EXTRA_GUISO
  var extraCosto = configProd.guisoX.length*precioExtra +
    configProd.salsas.reduce(function(s,n){var sl=SALSAS.find(function(x){return x.n===n});return s+(sl?sl.p:0)},0)+
    configProd.tops.reduce(function(s,n){var t=TOPPINGS.find(function(x){return x.n===n});return s+(t?t.p:0)},0)
  var precioUnit = p.precio_base + extraCosto
  var partes = []
  if (configProd.guiso1.length) partes.push(configProd.guiso1.join(', '))
  if (configProd.guisoX.length) partes.push(configProd.guisoX.map(function(g){return g+' (+$'+precioExtra+')'}).join(', '))
  if (configProd.salsas.length) partes.push(configProd.salsas.join(', '))
  if (configProd.tops.length) partes.push(configProd.tops.join(', '))
  if (configProd.sabor) partes.push(configProd.sabor)
  if (configProd.leche) partes.push(configProd.leche)
  if (configProd.notas) partes.push(configProd.notas)
  carrito.push({id:Date.now()+Math.random(), codigo:p.codigo, nombre:p.nombre, desc:partes.join(' | '), precio:precioUnit, qty:configProd.qty, familia:p.familias.nombre})
  document.getElementById('config-overlay').classList.remove('open')
  document.body.style.overflow = ''
  configProd = null
  actualizarFloat()
  actualizarCard(p.codigo)
}

function agregarDirecto(p) {
  carrito.push({id:Date.now()+Math.random(), codigo:p.codigo, nombre:p.nombre, desc:'', precio:p.precio_base, qty:1, familia:p.familias.nombre})
  actualizarFloat()
  actualizarCard(p.codigo)
}

function quitarDirecto(codigo) {
  for (var i=carrito.length-1;i>=0;i--) { if(carrito[i].codigo===codigo){carrito.splice(i,1);break} }
  actualizarFloat()
  actualizarCard(codigo)
}

function getQty(codigo) { return carrito.filter(function(i){return i.codigo===codigo}).reduce(function(s,i){return s+i.qty},0) }

function actualizarCard(codigo) {
  var p = productos.find(function(x){return x.codigo===codigo})
  if (!p) return
  var ctrl = document.getElementById('ctrl-'+codigo)
  if (!ctrl) return
  var color = CAT_COLOR[p.familias.nombre] || 'var(--red)'
  ctrl.innerHTML = renderControls(p, getQty(codigo), color)
  var card = document.getElementById('card-'+codigo)
  if (card) card.classList.toggle('in-cart', getQty(codigo)>0)
}

function actualizarFloat() {
  var total = carrito.reduce(function(s,i){return s+i.precio*i.qty},0)
  var count = carrito.reduce(function(s,i){return s+i.qty},0)
  var f = document.getElementById('cart-float')
  if (count > 0) {
    f.classList.add('show')
    document.getElementById('cart-bubble').textContent = count
    document.getElementById('cart-count-txt').textContent = count + ' producto' + (count>1?'s':'')
    document.getElementById('cart-total-txt').textContent = '$' + Math.round(total).toLocaleString('es-MX')
  } else {
    f.classList.remove('show')
  }
}

// ── CARRITO SHEET ─────────────────────────────────────────────
function abrirCarrito() {
  document.getElementById('cart-overlay').classList.add('open')
  document.body.style.overflow = 'hidden'
  renderCarrito()
}

function cerrarCarrito(e) {
  if (e && e.target !== document.getElementById('cart-overlay')) return
  document.getElementById('cart-overlay').classList.remove('open')
  document.body.style.overflow = ''
}

function renderCarrito() {
  var total = carrito.reduce(function(s,i){return s+i.precio*i.qty},0)
  var totalConEnvio = total + (modo==='domicilio'?costoEnvio:0)
  var html = ''
  carrito.forEach(function(item,idx) {
    html += '<div class="cart-item">' +
      '<div class="cart-item-info">' +
        '<div class="cart-item-name">'+item.qty+'x '+item.nombre+'</div>' +
        (item.desc?'<div class="cart-item-desc">'+item.desc+'</div>':'') +
      '</div>' +
      '<span class="cart-item-price">$'+Math.round(item.precio*item.qty).toLocaleString('es-MX')+'</span>' +
      '<button class="cart-del" onclick="borrarItem('+idx+')">×</button>' +
    '</div>'
  })

  // Sugeridos
  var codigosEnCarrito = carrito.map(function(i){return i.codigo})
  var sugeridos = []
  topProductos.forEach(function(tp) {
    var prod = productos.find(function(p){return p.nombre.toLowerCase()===tp.nombre.toLowerCase()})
    if (prod && !codigosEnCarrito.includes(prod.codigo)) sugeridos.push(prod)
  })
  sugeridos = sugeridos.slice(0,4)
  if (sugeridos.length > 0) {
    html += '<div class="sugeridos-wrap"><div class="sugeridos-title">👥 También les gusta</div><div class="sugeridos-scroll">'
    sugeridos.forEach(function(prod) {
      var color = CAT_COLOR[prod.familias.nombre] || 'var(--red)'
      html += '<div class="sug-card" onclick="cerrarCarrito({target:document.getElementById(\'cart-overlay\')});tocaProducto(\''+prod.codigo+'\')">' +
        '<div class="sug-name">'+prod.nombre+'</div>' +
        '<div class="sug-price" style="color:'+color+'">$'+Math.round(prod.precio_base)+'</div>' +
        '<div class="sug-add">+ Agregar</div>' +
        '</div>'
    })
    html += '</div></div>'
  }

  html += '<div class="cart-summary">'
  html += '<div class="summary-row"><span>Subtotal</span><span>$'+Math.round(total).toLocaleString('es-MX')+'</span></div>'
  if (modo==='domicilio' && costoEnvio>0) html += '<div class="summary-row"><span>🛵 Envío</span><span>$'+costoEnvio+'</span></div>'
  html += '<div class="summary-total"><span>Total</span><span style="color:var(--red)">$'+Math.round(totalConEnvio).toLocaleString('es-MX')+'</span></div>'
  html += '</div>'

  document.getElementById('cart-body').innerHTML = html

  // Método de pago en footer
  var fp = window_metodoPago
  var footerHtml = '<div style="font-size:12px;font-weight:800;color:var(--text2);margin-bottom:10px;text-transform:uppercase;letter-spacing:0.4px">¿Cómo pagas?</div>'
  footerHtml += '<div class="pay-methods">'
  ;[{id:'efectivo',icon:'💵',name:'Efectivo',sub:'Al entregar'},{id:'tarjeta',icon:'💳',name:'Tarjeta',sub:'Al entregar'},{id:'transferencia',icon:'🏦',name:'Transferencia',sub:'Por SPEI'}].forEach(function(m) {
    var sel = fp===m.id
    footerHtml += '<div class="pay-card'+(sel?' sel':'')+'" onclick="selMetodoPago(\''+m.id+'\')">' +
      '<div class="pay-icon">'+m.icon+'</div>' +
      '<div class="pay-name">'+m.name+'</div>' +
      '<div class="pay-sub">'+m.sub+'</div>' +
    '</div>'
  })
  footerHtml += '</div>'
  footerHtml += '<button class="btn btn-red" onclick="confirmarPedido()">Confirmar pedido →</button>'
  footerHtml += '<button class="btn btn-outline" onclick="cerrarCarrito({target:document.getElementById(\'cart-overlay\')})">Seguir agregando</button>'
  document.getElementById('cart-footer').innerHTML = footerHtml
}

function selMetodoPago(m) { window_metodoPago = m; renderCarrito() }

function borrarItem(idx) {
  var codigo = carrito[idx].codigo
  carrito.splice(idx,1)
  actualizarFloat()
  actualizarCard(codigo)
  if (carrito.length === 0) { cerrarCarrito({target:document.getElementById('cart-overlay')}); return }
  renderCarrito()
}

// ── CONFIRMAR PEDIDO ─────────────────────────────────────────
function confirmarPedido() {
  var nombre = document.getElementById('f-nombre').value.trim()
  var tel = document.getElementById('f-tel').value.trim()
  var dir = modo==='domicilio' ? getDireccion() : '—'
  var notas = (document.getElementById('f-notas')||{}).value||''
  var total = carrito.reduce(function(s,i){return s+i.precio*i.qty},0)
  var totalConEnvio = total + (modo==='domicilio'?costoEnvio:0)
  var id = Date.now().toString()
  comandaId = id
  var label = modo==='mesa'?('Mesa '+mesaParam):modo==='llevar'?'Para llevar 🥡':'Domicilio 🛵'
  var items = carrito.map(function(i){ return {id:i.id, plato:{nombre:i.nombre,familia:i.familia,codigo:i.codigo}, qty:i.qty, subtotal:i.precio*i.qty, precioUnit:i.precio, desc:i.desc} })
  var categsCompradas = [...new Set(carrito.map(function(i){return i.familia}).filter(Boolean))]
  guardarCliente(nombre, tel, totalConEnvio, categsCompradas, items, modo, dir)
  fetch(SB_URL+'/rest/v1/comandas_activas', {
    method:'POST',
    headers:{'apikey':SB_KEY,'Authorization':'Bearer '+SB_KEY,'Content-Type':'application/json','Prefer':'return=minimal'},
    body:JSON.stringify({id:id, label:label, tipo:modo==='mesa'?'mesa':'llevar', mesa:mesaParam||null, canal:'Efectivo', cliente:nombre+' '+tel, items:items, estado:'pendiente_pago', ronda:0, timer_minutos:15, timer_siguiente:5, created_at:new Date().toISOString(), updated_at:new Date().toISOString(), notas_cliente:(notas?notas+' ':'')+( modo==='domicilio'?'Dir: '+dir+' Envío: $'+costoEnvio+' ':'')+' Pago: '+(window_metodoPago==='efectivo'?'Efectivo al entregar':window_metodoPago==='tarjeta'?'Tarjeta al entregar':'Transferencia SPEI')})
  }).then(function(){ mostrarConfirm(nombre,tel,dir,notas,totalConEnvio,window_metodoPago) })
   .catch(function(){ mostrarConfirm(nombre,tel,dir,notas,totalConEnvio,window_metodoPago) })
}

function getDireccion() {
  var c=(document.getElementById('f-calle')||{}).value||''; var n=(document.getElementById('f-next')||{}).value||''; var ni=(document.getElementById('f-nint')||{}).value||''; var cp=(document.getElementById('f-cp')||{}).value||''; var col=(document.getElementById('f-colonia')||{}).value||''; var ciu=(document.getElementById('f-ciudad')||{}).value||'Aguascalientes'; var ref=(document.getElementById('f-refs')||{}).value||''
  return c+' '+n+(ni?' Int.'+ni:'')+', Col. '+col+', C.P. '+cp+', '+ciu+(ref?'. Ref: '+ref:'')
}

function guardarCliente(nombre, tel, totalConEnvio, categsCompradas, items, modo, dir) {
  var cats = {}; categsCompradas.forEach(function(c){cats[c]=1})
  var dirObj = modo==='domicilio'?{calle:(document.getElementById('f-calle')||{}).value||'',num_ext:(document.getElementById('f-next')||{}).value||'',colonia:(document.getElementById('f-colonia')||{}).value||'',cp:(document.getElementById('f-cp')||{}).value||'',ciudad:(document.getElementById('f-ciudad')||{}).value||'Aguascalientes'}:null
  fetch(SB_URL+'/rest/v1/clientes?telefono=eq.'+encodeURIComponent(tel)+'&select=id,total_pedidos,total_gastado,categorias_favoritas',{headers:{'apikey':SB_KEY,'Authorization':'Bearer '+SB_KEY}})
  .then(function(r){return r.ok?r.json():[]})
  .then(function(lista){
    var existe=lista&&lista.length>0?lista[0]:null
    if(existe){
      var catsA=existe.categorias_favoritas||{}; categsCompradas.forEach(function(c){catsA[c]=(catsA[c]||0)+1})
      fetch(SB_URL+'/rest/v1/clientes?id=eq.'+existe.id,{method:'PATCH',headers:{'apikey':SB_KEY,'Authorization':'Bearer '+SB_KEY,'Content-Type':'application/json','Prefer':'return=representation'},body:JSON.stringify({nombre:nombre,ultima_visita:new Date().toISOString().slice(0,10),total_pedidos:(existe.total_pedidos||0)+1,total_gastado:Math.round(((existe.total_gastado||0)+totalConEnvio)*100)/100,categorias_favoritas:catsA,updated_at:new Date().toISOString()})})
      .then(function(){fetch(SB_URL+'/rest/v1/clientes_pedidos',{method:'POST',headers:{'apikey':SB_KEY,'Authorization':'Bearer '+SB_KEY,'Content-Type':'application/json','Prefer':'return=minimal'},body:JSON.stringify({cliente_id:existe.id,fecha:new Date().toISOString().slice(0,10),items:items,total:totalConEnvio,canal:'menu_digital',modo:modo,estado:'pendiente'})})})
    }else{
      fetch(SB_URL+'/rest/v1/clientes',{method:'POST',headers:{'apikey':SB_KEY,'Authorization':'Bearer '+SB_KEY,'Content-Type':'application/json','Prefer':'return=representation'},body:JSON.stringify({nombre:nombre,telefono:tel,direccion:dirObj,total_pedidos:1,total_gastado:totalConEnvio,categorias_favoritas:cats,fuente:'menu_digital',primera_visita:new Date().toISOString().slice(0,10),ultima_visita:new Date().toISOString().slice(0,10)})})
      .then(function(r){return r.ok?r.json():null})
      .then(function(data){var cId=data&&data[0]&&data[0].id;if(cId)fetch(SB_URL+'/rest/v1/clientes_pedidos',{method:'POST',headers:{'apikey':SB_KEY,'Authorization':'Bearer '+SB_KEY,'Content-Type':'application/json','Prefer':'return=minimal'},body:JSON.stringify({cliente_id:cId,fecha:new Date().toISOString().slice(0,10),items:items,total:totalConEnvio,canal:'menu_digital',modo:modo,estado:'pendiente'})})})
    }
  }).catch(function(){})
}

