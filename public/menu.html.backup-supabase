  document.getElementById('config-overlay').classList.add('open')
  document.body.style.overflow = 'hidden'
}

function cerrarConfig(e) {
  if (e && e.target !== document.getElementById('config-overlay')) return
  document.getElementById('config-overlay').classList.remove('open')
  document.body.style.overflow = ''
  configProd = null
}

function renderConfig() {
  var p = configProd.p
  var fam = p.familias.nombre
  var color = CAT_COLOR[fam] || 'var(--red)'
  var precioExtra = p.precio_extra > 0 ? p.precio_extra : PRECIO_EXTRA_GUISO
  var extraCosto = configProd.guisoX.length * precioExtra +
    configProd.salsas.reduce(function(s,n){ var sl=SALSAS.find(function(x){return x.n===n}); return s+(sl?sl.p:0) }, 0) +
    configProd.tops.reduce(function(s,n){ var t=TOPPINGS.find(function(x){return x.n===n}); return s+(t?t.p:0) }, 0)
  var totalUnit = p.precio_base + extraCosto
  var total = totalUnit * configProd.qty

  document.getElementById('cfg-title').textContent = p.nombre
  document.getElementById('cfg-price').textContent = '$' + Math.round(p.precio_base)
  document.getElementById('cfg-price').style.color = color

  var html = ''

  if (CON_GUISO.includes(fam) && !CON_2_GUISOS.includes(fam)) {
    html += '<div class="opcion-label">🥘 Guiso incluido (elige 1)</div><div class="chips-wrap">'
    GUISOS.forEach(function(g) {
      var sel = configProd.guiso1.includes(g)
      html += '<span class="chip'+(sel?' sel':'')+'" onclick="togGuiso1(\''+g+'\')">'+g+'</span>'
    })
    html += '</div>'
    html += '<div class="opcion-label">➕ Guiso extra (+$'+precioExtra+' c/u)</div><div class="chips-wrap">'
    GUISOS.forEach(function(g) {
      var sel = configProd.guisoX.includes(g)
