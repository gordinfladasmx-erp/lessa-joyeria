    SABORES_LATTE.forEach(function(s) { html += '<span class="chip'+(configProd.sabor===s?' sel':'')+'" onclick="setSabor(\''+s+'\')">'+s+'</span>' })
    html += '</div>'
    html += '<div class="opcion-label">🥛 Leche</div><div class="chips-wrap">'
    LECHE_LATTE.forEach(function(l) { html += '<span class="chip'+(configProd.leche===l?' sel':'')+'" onclick="setLeche(\''+l+'\')">'+l+'</span>' })
    html += '</div>'
