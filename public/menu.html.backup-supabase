}

// ── RENDER MENÚ ─────────────────────────────────────────────
function renderMenu() {
  var catsBar = document.getElementById('cats-bar')
  var content = document.getElementById('menu-content')
  var recs = document.getElementById('recs-section')
  catsBar.innerHTML = ''; content.innerHTML = ''

  // Recomendaciones
  if (topProductos.length > 0) {
    var html = '<div class="recs-wrap"><div class="recs-title">🔥 Los más pedidos</div><div class="recs-scroll">'
    topProductos.slice(0,6).forEach(function(tp) {
      var prod = productos.find(function(p){ return p.nombre.toLowerCase() === tp.nombre.toLowerCase() })
      if (!prod) return
      var color = CAT_COLOR[prod.familias.nombre] || 'var(--red)'
      html += '<div class="rec-card" onclick="tocaProducto(\''+prod.codigo+'\')" style="border-color:'+color+'22">' +
        '<div class="rec-badge" style="background:'+color+'18;color:'+color+'">⭐ Popular</div>' +
        '<div class="rec-name">'+prod.nombre+'</div>' +
        '<div class="rec-price" style="color:'+color+'">$'+Math.round(prod.precio_base)+'</div>' +
        '</div>'
    })
    html += '</div></div>'
    recs.innerHTML = html
  }

  var fams = Object.keys(grupos)
  fams.forEach(function(fam, i) {
    var color = CAT_COLOR[fam] || '#888'
    var emoji = CAT_EMOJI[fam] || '🍽'
    // Cat pill
    var pill = document.createElement('button')
    pill.className = 'cat-pill' + (i===0?' active':'')
    pill.textContent = emoji + ' ' + fam
    pill.onclick = function() {
      document.querySelectorAll('.cat-pill').forEach(function(p){ p.classList.remove('active') })
      pill.classList.add('active')
      document.getElementById('sec-'+esc(fam)).scrollIntoView({behavior:'smooth',block:'start'})
    }
    catsBar.appendChild(pill)

    // Sección
    var sec = document.createElement('div')
    sec.className = 'cat-section'
    sec.id = 'sec-'+esc(fam)
    sec.innerHTML = '<div class="cat-header"><div class="cat-dot" style="background:'+color+'"></div>'+emoji+' '+fam+'</div>'
    if (CAT_INCLUYE[fam]) {
      var inc = document.createElement('div')
      inc.className = 'cat-desc'
      inc.textContent = CAT_INCLUYE[fam]
      sec.appendChild(inc)
    }
    grupos[fam].forEach(function(p) {
      var card = document.createElement('div')
      card.className = 'prod-card'
      card.id = 'card-'+p.codigo
      var qty = getQty(p.codigo)
      card.innerHTML =
        '<div class="prod-img-placeholder">'+( CAT_EMOJI[fam]||'🍽')+'</div>' +
        '<div class="prod-body">' +
          '<div class="prod-name">'+p.nombre+'</div>' +
          '<div class="prod-footer">' +
            '<div class="prod-price" style="color:'+color+'">$'+Math.round(p.precio_base)+'</div>' +
            '<div class="prod-controls" id="ctrl-'+p.codigo+'">'+renderControls(p, qty, color)+'</div>' +
          '</div>' +
        '</div>'
      sec.appendChild(card)
    })
    content.appendChild(sec)
  })

  // Observer para active pill
  setupScrollSpy()
}

function renderControls(p, qty, color) {
  if (qty === 0) {
    return '<button class="prod-add" data-codigo="'+p.codigo+'" data-action="add" style="background:'+color+'">+</button>'
  }
  return '<div class="qty-controls">' +
    '<button class="qty-btn" data-codigo="'+p.codigo+'" data-action="remove" style="border-color:'+color+';color:'+color+'">−</button>' +
    '<span class="qty-num">'+qty+'</span>' +
    '<button class="qty-btn plus" data-codigo="'+p.codigo+'" data-action="add" style="background:'+color+';border-color:'+color+'">+</button>' +
  '</div>'
}

function setupScrollSpy() {
  if (!('IntersectionObserver' in window)) return
  var secs = document.querySelectorAll('.cat-section')
  var obs = new IntersectionObserver(function(entries) {
    entries.forEach(function(e) {
      if (e.isIntersecting) {
        var fam = e.target.id.replace('sec-','').replace(/-/g,' ')
        document.querySelectorAll('.cat-pill').forEach(function(p) {
          p.classList.toggle('active', p.textContent.trim().indexOf(fam.substring(0,5)) >= 0)
        })
      }
    })
  }, {threshold:0.3, rootMargin:'-80px 0px -60% 0px'})
  secs.forEach(function(s){ obs.observe(s) })
}

function esc(s){ return s.replace(/[^a-zA-Z0-9]/g,'-') }

// ── EVENTOS ─────────────────────────────────────────────────
document.addEventListener('click', function(e) {
  var btn = e.target.closest('[data-action]')
  if (!btn) return
  if (document.getElementById('screen-menu').style.display === 'none') return
  var codigo = btn.getAttribute('data-codigo')
  var action = btn.getAttribute('data-action')
  if (action === 'add') tocaProducto(codigo)
  if (action === 'remove') quitarDirecto(codigo)
})

function tocaProducto(codigo) {
  var p = productos.find(function(x){ return x.codigo === codigo })
  if (!p) return
  var fam = p.familias.nombre
  if (SIN_OPCIONES.includes(fam)) { agregarDirecto(p); return }
  abrirConfig(p)
}

