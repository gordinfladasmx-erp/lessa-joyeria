      (metodoPago==='transferencia'?'Enviar comprobante por WhatsApp':'Confirmar pedido por WhatsApp')+
    '</a>'+
    '<button class="cancel-btn" onclick="cancelarPedido()">✕ Cancelar pedido</button>'
}

function cancelarPedido() {
  if (!confirm('¿Cancelar tu pedido?')) return
  if (comandaId) {
    fetch(SB_URL+'/rest/v1/comandas_activas?id=eq.'+comandaId, {method:'DELETE', headers:{'apikey':SB_KEY,'Authorization':'Bearer '+SB_KEY}})
    .then(function(){ comandaId=null })
  }
  document.getElementById('cart-body').innerHTML = '<div style="text-align:center;padding:40px 20px"><div style="font-size:40px;margin-bottom:12px">❌</div><div style="font-size:16px;font-weight:800;margin-bottom:8px">Pedido cancelado</div><p style="font-size:13px;color:var(--text2)">Tu pedido fue cancelado correctamente.</p></div>'
  document.getElementById('cart-footer').innerHTML = '<button class="btn btn-red" onclick="location.reload()">Hacer nuevo pedido</button>'
}
</script>
</body>
</html>
