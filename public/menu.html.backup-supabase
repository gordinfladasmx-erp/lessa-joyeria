// ── CARGAR PRODUCTOS ─────────────────────────────────────────
function cargarProductos() {
  fetch(SB_URL+'/rest/v1/productos?select=codigo,nombre,precio_base,precio_extra,activo,familia_id,familias!productos_familia_id_fkey(nombre)&activo=eq.true&order=nombre', {
    headers:{'apikey':SB_KEY,'Authorization':'Bearer '+SB_KEY}
  }).then(function(r){return r.json()})
  .then(function(data) {
    productos = data.filter(function(p){ 
      // Normalizar familias - puede venir como array o como objeto
      if (p.familias && Array.isArray(p.familias)) p.familias = p.familias[0]
      return p.familias && p.familias.nombre 
    })
    grupos = {}
    var orden = ['Los Chilakiles','Huevos y Crokantes','Del Comal','Los Dorados','Enfrijoladas','1/2 Litros','Bebidas Frías','Bebidas Calientes','Postres']
    productos.forEach(function(p) {
      var fam = p.familias.nombre
      if (!grupos[fam]) grupos[fam] = []
      grupos[fam].push(p)
    })
    // Reordenar según orden predefinido
    var gruposOrdenados = {}
    orden.forEach(function(fam) { if (grupos[fam]) gruposOrdenados[fam] = grupos[fam] })
    Object.keys(grupos).forEach(function(fam) { if (!gruposOrdenados[fam]) gruposOrdenados[fam] = grupos[fam] })
    grupos = gruposOrdenados
    cargarTopProductos()
    renderMenu()
  })
  .catch(function(){ renderMenuFallback() })
}

function cargarTopProductos() {
  fetch(SB_URL+'/rest/v1/ventas?select=producto,unidades&fecha=gte.'+hace30dias()+'&order=unidades.desc&limit=200', {
    headers:{'apikey':SB_KEY,'Authorization':'Bearer '+SB_KEY}
  }).then(function(r){return r.json()})
  .then(function(data) {
    var m = {}
    ;(data||[]).forEach(function(r){ if(r.producto && r.unidades) m[r.producto] = (m[r.producto]||0) + r.unidades })
    topProductos = Object.keys(m).sort(function(a,b){return m[b]-m[a]}).slice(0,8).map(function(n){ return {nombre:n, uds:m[n]} })
  }).catch(function(){})
}

function hace30dias() {
  var d = new Date(); d.setDate(d.getDate()-30)
  return d.toISOString().slice(0,10)
}

function renderMenuFallback() {
