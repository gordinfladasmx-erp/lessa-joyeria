<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>Chilakileando · Menú</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&display=swap" rel="stylesheet">
<style>
:root {
  --red: #E63946;
  --red-light: #FFF0F0;
  --green: #2D9E6A;
  --yellow: #F4A261;
  --bg: #F7F5F2;
  --surface: #FFFFFF;
  --text: #1C1C1E;
  --text2: #6E6E73;
  --text3: #AEAEB2;
  --border: #E5E5EA;
  --r: 16px;
  --r-sm: 10px;
  --shadow: 0 2px 12px rgba(0,0,0,0.08);
  --shadow-lg: 0 8px 32px rgba(0,0,0,0.12);
}
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
body{font-family:'Nunito',sans-serif;background:var(--bg);color:var(--text);min-height:100vh}

/* ── HEADER ── */
.hdr{background:var(--surface);position:sticky;top:0;z-index:100;border-bottom:1px solid var(--border)}
.hdr-hero{background:var(--red);padding:16px 16px 20px;position:relative;overflow:hidden}
.hdr-inner{max-width:900px;margin:0 auto}
.hdr-hero::before{content:'';position:absolute;inset:0;background:url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.05'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E")}
.hdr-brand{display:flex;align-items:center;gap:12px;position:relative}
.hdr-logo{width:52px;height:52px;border-radius:14px;border:3px solid rgba(255,255,255,0.3);object-fit:cover;background:#fff;flex-shrink:0}
.hdr-name{font-size:20px;font-weight:900;color:#fff;line-height:1.1;letter-spacing:-0.3px}
.hdr-sub{font-size:11px;color:rgba(255,255,255,0.75);margin-top:2px;font-weight:600}
.hdr-badges{display:flex;gap:8px;margin-top:10px;position:relative}
.badge{background:rgba(255,255,255,0.15);backdrop-filter:blur(8px);border:1px solid rgba(255,255,255,0.2);border-radius:99px;padding:5px 11px;font-size:11px;font-weight:700;color:#fff;display:flex;align-items:center;gap:4px}
.badge-green{background:rgba(45,158,106,0.9);border-color:rgba(45,158,106,0.5)}
.badge-yellow{background:rgba(244,162,97,0.9);border-color:rgba(244,162,97,0.5)}
.hdr-wa{position:absolute;right:0;top:0;background:#25D366;border:none;border-radius:12px;padding:8px 12px;color:#fff;font-size:11px;font-weight:800;cursor:pointer;display:flex;align-items:center;gap:5px;text-decoration:none}

/* ── CATS ── */
.cats-wrap{background:var(--surface);padding:10px 0;border-bottom:1px solid var(--border)}
.cats-scroll{display:flex;gap:8px;padding:0 16px;overflow-x:auto;scrollbar-width:none;max-width:900px;margin:0 auto}
.cats-scroll::-webkit-scrollbar{display:none}
.cat-pill{white-space:nowrap;padding:8px 16px;border-radius:99px;border:1.5px solid var(--border);background:var(--surface);font-size:13px;font-weight:700;cursor:pointer;color:var(--text2);flex-shrink:0;transition:all 0.15s;font-family:'Nunito',sans-serif}
.cat-pill.active{border-color:var(--red);color:var(--red);background:var(--red-light)}

/* ── MODO SCREEN ── */
.screen{padding:20px 16px;animation:fadeUp 0.3s ease;max-width:540px;margin:0 auto}
@keyframes fadeUp{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}
.screen-title{font-size:22px;font-weight:900;margin-bottom:6px}
.screen-sub{font-size:13px;color:var(--text2);margin-bottom:20px;line-height:1.5}
.modo-card{background:var(--surface);border-radius:var(--r);padding:16px;margin-bottom:10px;display:flex;align-items:center;gap:14px;cursor:pointer;border:2px solid var(--border);transition:all 0.15s;box-shadow:var(--shadow)}
.modo-card:active{transform:scale(0.98)}
.modo-card.sel{border-color:var(--red);background:var(--red-light)}
.modo-icon-wrap{width:48px;height:48px;border-radius:14px;background:var(--bg);display:flex;align-items:center;justify-content:center;font-size:24px;flex-shrink:0}
.modo-card.sel .modo-icon-wrap{background:var(--red-light)}
.modo-info h3{font-size:15px;font-weight:800;margin-bottom:2px}
.modo-info p{font-size:12px;color:var(--text2);line-height:1.4}

/* ── FORM ── */
.field{margin-bottom:14px}
.field label{display:block;font-size:12px;font-weight:700;color:var(--text2);margin-bottom:6px;letter-spacing:0.2px}
.field input,.field textarea,.field select{width:100%;padding:13px 14px;border:1.5px solid var(--border);border-radius:var(--r-sm);font-size:14px;font-family:'Nunito',sans-serif;color:var(--text);background:var(--surface);outline:none;transition:border-color 0.15s}
.field input:focus,.field textarea:focus{border-color:var(--red)}
.field textarea{resize:none;height:72px}
.field-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}

/* ── BOTONES GLOBALES ── */
.btn{width:100%;padding:15px;border:none;border-radius:var(--r);font-size:15px;font-weight:800;cursor:pointer;font-family:'Nunito',sans-serif;transition:all 0.15s}
.btn:active{transform:scale(0.98)}
.btn-red{background:var(--red);color:#fff}
.btn-red:disabled{opacity:0.35;cursor:not-allowed}
.btn-outline{background:transparent;border:1.5px solid var(--border);color:var(--text2);margin-top:8px}
.btn-sm{padding:10px 16px;font-size:13px;width:auto;border-radius:var(--r-sm)}

/* ── MENU CONTENT ── */
.menu-wrap{padding-bottom:100px;max-width:900px;margin:0 auto}
.cat-section{padding:0 16px;margin-bottom:4px}
@media(min-width:700px){.cat-section{padding:0 24px}.prod-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.prod-card{margin-bottom:0}}
.cat-header{font-size:14px;font-weight:900;padding:16px 0 10px;display:flex;align-items:center;gap:8px}
.cat-dot{width:10px;height:10px;border-radius:50%;flex-shrink:0}
.cat-desc{font-size:11px;color:var(--text2);background:var(--surface);border-radius:var(--r-sm);padding:8px 12px;margin-bottom:10px;line-height:1.5;border:1px solid var(--border)}

/* ── PRODUCT CARD ── */
.prod-card{background:var(--surface);border-radius:var(--r);padding:14px;margin-bottom:8px;box-shadow:var(--shadow);border:1.5px solid transparent;transition:border-color 0.15s;display:flex;gap:12px;align-items:flex-start}
.prod-card.in-cart{border-color:var(--red)}
.prod-img-placeholder{width:72px;height:72px;border-radius:12px;background:linear-gradient(135deg,#f0ebe4,#e8e0d5);flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:28px}
.prod-body{flex:1;min-width:0}
.prod-name{font-size:14px;font-weight:800;margin-bottom:3px;line-height:1.3}
.prod-desc{font-size:11px;color:var(--text2);line-height:1.5;margin-bottom:8px}
.prod-footer{display:flex;align-items:center;justify-content:space-between}
.prod-price{font-size:16px;font-weight:900;color:var(--red)}
.prod-add{width:36px;height:36px;border-radius:50%;border:none;background:var(--red);color:#fff;font-size:22px;font-weight:700;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:transform 0.15s;flex-shrink:0}
.prod-add:active{transform:scale(0.88)}
.qty-controls{display:flex;align-items:center;gap:10px}
.qty-btn{width:32px;height:32px;border-radius:50%;border:2px solid var(--red);background:var(--surface);color:var(--red);font-size:18px;font-weight:800;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all 0.15s}
.qty-btn.plus{background:var(--red);color:#fff}
.qty-num{font-size:15px;font-weight:900;min-width:20px;text-align:center}

/* ── CARRITO FLOTANTE ── */
.cart-float{position:fixed;bottom:20px;left:50%;transform:translateX(-50%) translateY(120px);width:calc(100% - 32px);max-width:446px;background:var(--text);border-radius:var(--r);padding:14px 18px;display:flex;align-items:center;justify-content:space-between;z-index:200;transition:transform 0.35s cubic-bezier(0.34,1.56,0.64,1);box-shadow:0 8px 32px rgba(0,0,0,0.25)}
.cart-float.show{transform:translateX(-50%) translateY(0)}
.cart-float-left{display:flex;align-items:center;gap:10px}
.cart-bubble{background:var(--red);color:#fff;width:28px;height:28px;border-radius:50%;font-size:13px;font-weight:900;display:flex;align-items:center;justify-content:center}
.cart-float-info{color:#fff}
.cart-float-count{font-size:12px;opacity:0.7;font-weight:600}
.cart-float-total{font-size:16px;font-weight:900}
.cart-float-btn{background:var(--red);color:#fff;border:none;border-radius:var(--r-sm);padding:10px 18px;font-size:14px;font-weight:800;cursor:pointer;font-family:'Nunito',sans-serif}

/* ── BOTTOM SHEET ── */
.sheet-overlay{position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:300;display:none;align-items:flex-end;justify-content:center}
.sheet-overlay.open{display:flex;animation:fadeIn 0.2s ease}
@keyframes fadeIn{from{opacity:0}to{opacity:1}}
.sheet{background:var(--surface);border-radius:20px 20px 0 0;padding:0;width:100%;max-width:680px;max-height:85vh;display:flex;flex-direction:column;animation:slideUp 0.3s cubic-bezier(0.34,1.1,0.64,1);overflow:hidden}
@keyframes slideUp{from{transform:translateY(100%)}to{transform:translateY(0)}}
.sheet-handle{width:40px;height:4px;background:var(--border);border-radius:99px;margin:12px auto 0}
.sheet-header{padding:16px 20px 12px;border-bottom:1px solid var(--border)}
.sheet-title{font-size:18px;font-weight:900}
.sheet-price{font-size:14px;color:var(--red);font-weight:700;margin-top:2px}
.sheet-body{overflow-y:auto;padding:16px 20px;flex:1}
.sheet-footer{padding:16px 20px;border-top:1px solid var(--border);background:var(--surface)}
.opcion-label{font-size:11px;font-weight:800;color:var(--text2);text-transform:uppercase;letter-spacing:0.6px;margin-bottom:10px;margin-top:4px}
.chips-wrap{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:16px}
.chip{padding:9px 15px;border:1.5px solid var(--border);border-radius:99px;font-size:13px;cursor:pointer;color:var(--text2);background:var(--surface);font-weight:600;transition:all 0.12s;font-family:'Nunito',sans-serif}
.chip.sel{border-color:var(--red);background:var(--red-light);color:var(--red);font-weight:800}
.chip.sel-green{border-color:var(--green);background:#EAF7F0;color:var(--green);font-weight:800}
.chip.sel-blue{border-color:#378ADD;background:#E6F1FB;color:#378ADD;font-weight:800}
.qty-row-big{display:flex;align-items:center;gap:14px;justify-content:center;padding:8px 0}
.qty-btn-big{width:44px;height:44px;border-radius:50%;border:2px solid var(--red);background:var(--surface);color:var(--red);font-size:24px;font-weight:800;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all 0.15s}
.qty-btn-big.add{background:var(--red);color:#fff}
.qty-num-big{font-size:22px;font-weight:900;min-width:36px;text-align:center}
.cfg-total{font-size:16px;font-weight:800;color:var(--text);margin-left:auto}

/* ── CARRITO SHEET ── */
.cart-item{display:flex;align-items:flex-start;gap:12px;padding:12px 0;border-bottom:1px solid var(--border)}
.cart-item-info{flex:1}
.cart-item-name{font-size:13px;font-weight:800}
.cart-item-desc{font-size:11px;color:var(--text2);line-height:1.5;margin-top:2px}
.cart-item-price{font-size:13px;font-weight:800;color:var(--red);white-space:nowrap}
.cart-del{background:none;border:none;color:var(--text3);font-size:18px;cursor:pointer;padding:0 4px}
.cart-summary{margin-top:8px}
.summary-row{display:flex;justify-content:space-between;font-size:13px;padding:5px 0;color:var(--text2)}
.summary-total{display:flex;justify-content:space-between;font-size:18px;font-weight:900;padding:12px 0;border-top:2px solid var(--text);margin-top:4px}
.pay-methods{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:14px 0}
.pay-card{border:2px solid var(--border);border-radius:var(--r-sm);padding:12px 6px;text-align:center;cursor:pointer;transition:all 0.15s;background:var(--surface)}
.pay-card.sel{border-color:var(--red);background:var(--red-light)}
.pay-icon{font-size:22px;margin-bottom:4px}
.pay-name{font-size:12px;font-weight:800;color:var(--text2)}
.pay-card.sel .pay-name{color:var(--red)}
.pay-sub{font-size:10px;color:var(--text3)}

/* ── CONFIRM ── */
.confirm-wrap{text-align:center;padding:8px 0}
.confirm-emoji{font-size:56px;margin-bottom:14px}
.confirm-title{font-size:22px;font-weight:900;margin-bottom:6px}
.confirm-sub{font-size:13px;color:var(--text2);line-height:1.6;margin-bottom:20px}
.resumen-box{background:var(--bg);border-radius:var(--r);padding:14px;text-align:left;font-size:12px;color:var(--text2);line-height:1.9;margin-bottom:14px}
.monto-box{background:#EAF7F0;border-radius:var(--r);padding:16px;margin-bottom:12px;text-align:left}
.monto-label{font-size:11px;color:var(--green);font-weight:700;margin-bottom:3px}
.monto-num{font-size:28px;font-weight:900;color:var(--green)}
.clabe-box{background:var(--bg);border-radius:var(--r);padding:14px;margin-bottom:14px;text-align:left;border:1px solid var(--border)}
.clabe-label{font-size:11px;color:var(--text2);font-weight:700;margin-bottom:4px}
.clabe-num{font-size:18px;font-weight:900;letter-spacing:1.5px;font-family:monospace;color:var(--text)}
.clabe-banco{font-size:11px;color:var(--text2);margin-top:3px}
.wa-btn{display:flex;align-items:center;justify-content:center;gap:8px;width:100%;padding:16px;background:#25D366;color:#fff;border:none;border-radius:var(--r);font-size:15px;font-weight:800;cursor:pointer;text-decoration:none;font-family:'Nunito',sans-serif;margin-bottom:8px}
.cancel-btn{width:100%;padding:11px;background:transparent;border:1.5px solid #E63946;border-radius:var(--r-sm);font-size:13px;cursor:pointer;color:var(--red);font-weight:700;font-family:'Nunito',sans-serif;margin-top:4px}

/* ── RECOMENDACIONES ── */
.recs-wrap{padding:0 16px;margin-bottom:4px}
.recs-title{font-size:13px;font-weight:900;margin-bottom:10px;display:flex;align-items:center;gap:6px}
.recs-scroll{display:flex;gap:10px;overflow-x:auto;padding-bottom:4px;scrollbar-width:none}
.recs-scroll::-webkit-scrollbar{display:none}
.rec-card{background:var(--surface);border-radius:var(--r-sm);padding:12px;min-width:130px;flex-shrink:0;cursor:pointer;box-shadow:var(--shadow);border:1.5px solid transparent;transition:all 0.15s}
.rec-card:active{transform:scale(0.97)}
.rec-badge{font-size:9px;font-weight:800;padding:2px 8px;border-radius:99px;display:inline-block;margin-bottom:5px}
.rec-name{font-size:12px;font-weight:800;margin-bottom:3px;line-height:1.3}
.rec-price{font-size:13px;font-weight:900;color:var(--red)}

/* ── SUGERIDOS ── */
.sugeridos-wrap{margin:12px 0}
.sugeridos-title{font-size:12px;font-weight:800;color:var(--text2);margin-bottom:10px}
.sugeridos-scroll{display:flex;gap:8px;overflow-x:auto;scrollbar-width:none}
.sugeridos-scroll::-webkit-scrollbar{display:none}
.sug-card{background:var(--bg);border-radius:var(--r-sm);padding:10px;min-width:110px;flex-shrink:0;cursor:pointer;border:1.5px solid var(--border);text-align:center;transition:all 0.12s}
.sug-card:active{transform:scale(0.97)}
.sug-name{font-size:11px;font-weight:800;margin-bottom:3px;line-height:1.3}
.sug-price{font-size:12px;font-weight:900;color:var(--red)}
.sug-add{font-size:10px;color:var(--text3);margin-top:2px}

/* ── MEDIA QUERY ── */
@media(min-width:480px){
  .cart-float{left:50%;right:auto;transform:translateX(-50%) translateY(120px);width:calc(100% - 32px);max-width:680px}
  .cart-float.show{transform:translateX(-50%) translateY(0)}
  .hdr-hero{padding:20px 24px 24px}
  .hdr-brand{max-width:900px;margin:0 auto}
  .hdr-badges{max-width:900px;margin:10px auto 0}
  .recs-wrap{padding:0 24px}
}
</style>
</head>
